# Telegram Bot
BOT_TOKEN=your_telegram_bot_token_here

# LLM Backend
LLM_BACKEND=ollama          # ollama | openai_compatible
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:latest  # or llama3.1, mistral, qwen2.5, etc.

# OpenAI-compatible (for llama.cpp server, vLLM, etc.)
OPENAI_API_BASE=http://localhost:8080/v1
OPENAI_API_KEY=not-needed
OPENAI_MODEL=local-model

# Chat settings
SYSTEM_PROMPT=Ти — корисний асистент. Відповідай українською мовою.
MAX_HISTORY_LENGTH=20        # кількість пар повідомлень в історії
MAX_TOKENS=2048
TEMPERATURE=0.7
